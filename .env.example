# Docker Compose Environment Configuration
# Copy this to .env and fill in your values

# Database Configuration
DB_PASSWORD=secure_password_change_me
DB_USER=vaultic_user
DB_NAME=vaultic_db
DB_HOST=postgres
DB_PORT=5432

# Backend Configuration
ENVIRONMENT=development
DEBUG_MODE=true

# API Keys
GOOGLE_API_KEY=your_google_api_key_here
VAULTIC_WEBHOOK_SECRET=webhook_secret_change_me

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:80"]

# Authentication
SECRET_KEY=your_secret_key_change_me_in_production

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# SSL/TLS (for nginx)
# Generate with: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ML Models
ML_MODEL_PATH=/app/ml/models
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=INFO
