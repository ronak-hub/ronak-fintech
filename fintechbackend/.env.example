# Template for local development. Keep real credentials in the ignored .env.local file.
ENVIRONMENT=development
DEBUG_MODE=true
DATABASE_URL=sqlite:///./finova_core.db
SECRET_KEY=replace-this-local-development-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VAULTIC_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Optional Google OAuth. Put credentials in .env.local; register this exact callback URI.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback
# Keep true when outbound internet requires your system proxy; local override may set false.
GOOGLE_USE_SYSTEM_PROXY=true
# For Docker, use http://localhost:8001/auth/google/callback. For production,
# set the exact HTTPS callback URL registered in Google Cloud Console.

# Optional Gemini settings. Put GOOGLE_API_KEY in .env.local.
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_MODEL_NAME=gemini-3.8-flash
